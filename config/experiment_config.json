{
  "experiment": {
    "name": "financial_news_ranking_evaluation",
    "description": "Comparative evaluation of approaches for ranking financial news",
    "dataset": {
      "tickers": "SP_100",
      "start_date": "2026-01-01",
      "end_date": "2026-03-31",
      "significance_threshold": 2.0
    },
    "batching": {
      "batch_size": 50,
      "top_k": 10,
      "random_seed": 42
    },
    "evaluation": {
      "num_consistency_runs": 10,
      "consistency_batches": 5,
      "scalability_sizes": [50, 100, 200, 500, 1000, 5000],
      "subtract_market": false,
      "standardize": false
    },
    "apis": {
      "groq": {
        "rate_limit_delay": 2.0,
        "max_retries": 3
      },
      "openai": {
        "rate_limit_delay": 1.0,
        "max_retries": 3
      }
    },
    "logging": {
      "level": "INFO",
      "file": "experiment.log"
    }
  }
}
